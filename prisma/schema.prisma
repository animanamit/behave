// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// BETTER AUTH TABLES
// ============================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz

  // Relations
  sessions         Session[]
  accounts         Account[]
  starAnswers      StarAnswer[]
  practiceSessions PracticeSession[]
  files            File[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz
  token     String   @unique
  createdAt DateTime @db.Timestamptz
  updatedAt DateTime @db.Timestamptz
  ipAddress String?
  userAgent String?
  userId    String

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @db.Timestamptz
  updatedAt             DateTime  @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamptz
  createdAt  DateTime? @db.Timestamptz
  updatedAt  DateTime? @db.Timestamptz

  @@map("verification")
  @@index([identifier])
}

// ============================================
// APPLICATION TABLES
// ============================================

model StarAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String
  competency String
  question   String
  situation  String
  task       String
  action     String
  result     String
  fullAnswer String
  createdAt  DateTime @default(now()) @db.Timestamptz

  // Relations
  user             User              @relation(fields: [userId], references: [id])
  practiceSessions PracticeSession[]

  @@map("starAnswers")
}

model PracticeSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String
  answerId       String   @db.Uuid
  videoUrl       String
  audioUrl       String?
  thumbnailUrl   String?
  transcript     String?
  duration       Int?
  analysisStatus String   @default("pending") // pending, transcribing, analyzing, completed, failed
  recordedAt     DateTime @default(now()) @db.Timestamptz

  // Relations
  user            User              @relation(fields: [userId], references: [id])
  answer          StarAnswer        @relation(fields: [answerId], references: [id])
  sessionFeedback SessionFeedback[]

  @@map("practiceSessions")
}

model SessionFeedback {
  id                   String   @id @default(uuid()) @db.Uuid
  sessionId            String   @db.Uuid
  contentFidelityScore Int
  pacing               String
  confidence           String
  suggestions          String
  wordsMatched         Int?
  totalWords           Int?
  keyPointsMissed      String?
  wentOffScript        Boolean  @default(false)
  offScriptImprovement  String?
  createdAt            DateTime @default(now()) @db.Timestamptz

  // Relations
  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Ensure only one feedback per session (idempotency)
  @@unique([sessionId])
  @@map("sessionFeedback")
}

model File {
  id          String   @id @default(uuid())
  userId      String
  s3Key       String
  fileName    String
  fileSize    Int
  contentType String
  uploadedAt  DateTime @default(now()) @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("files")
}
